/** @var \Mageplaza\GoogleMaps\Block\Map $block */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */
$scriptString = "
    (function() {
        var script = document.createElement('script');
        script.src = 'https://maps.googleapis.com/maps/api/js?key=" . $block->getMapApi() . "';
        script.async = true;
        script.defer = true;
        script.onload = function() {
            initMap();
        };
        document.head.appendChild(script);

        function initMap() {
            var mapLatLng = new google.maps.LatLng(" . $block->getMapLatitude() . ", " . $block->getMapLongitude() . ");
            var mapOptions = {
                draggable: " . ($block->isMapDraggable() ? 'true' : 'false') . ",
                zoom: " . $block->getMapZoomDefault() . ",
                center: mapLatLng,
                mapTypeId: '" . $block->getMapTypeId() . "',
                styles: JSON.parse(" . $block->getMapTemplate() . ")
            };

            var map = new google.maps.Map(document.getElementById('mpgooglemaps_map_" . $block->getNameInLayout() . "'), mapOptions);
            var marker = new google.maps.Marker({
                position: mapLatLng,
                icon: { url: '" . $block->getMapMarkerIcon() . "', scaledSize: new google.maps.Size(40, 40) },
                animation: google.maps.Animation.DROP
            });
            marker.setMap(map);
        }
    })();
";
?>
<?php if ($block->isEnabledModule() && $block->getProtocol() == Mageplaza\GoogleMaps\Model\Config\Source\System\Protocol::API): ?>
    <div class="mpgooglemaps_review_map">
        <div class="mpgooglemaps_map" id="mpgooglemaps_map_<?php /* @noEscaped */ echo $block->getNameInLayout() ?>"
             style="height: 550px;width: 100%;margin: 15px 0;">
        </div>
    </div>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
<?php else: ?>
    <div class="mpgooglemaps_review_map" style="float: left;width: 100%;margin: 15px 0;">
        <?php /* @noEscaped */ echo $block->getEmbedCode(); ?>
    </div>
<?php endif; ?>